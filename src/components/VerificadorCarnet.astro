---
import revocaciones from '../data/revocaciones.json';
import { DEMO_SAMPLE_TOKEN } from '../lib/crypto-carnet';
import Icon from './Icon.astro';
---

<section
  id="verificador-carnet"
  data-demo-token={DEMO_SAMPLE_TOKEN}
  data-revocados={JSON.stringify(revocaciones.revocados)}
  class="rounded-2xl border-2 border-navy-900 bg-white p-6 sm:p-8 shadow-md"
  aria-labelledby="verificador-heading"
>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-border pb-4">
    <div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-navy-900 text-gold-300 text-xs font-bold uppercase tracking-wider px-3 py-1">
        <Icon name="key" class="w-3.5 h-3.5" />
        <span>Criptografía Ed25519 · Rotación kid · Soporte QR (#token=)</span>
      </span>
      <h2 id="verificador-heading" class="mt-2.5 text-2xl font-bold text-navy-900">
        Verificador Oficial de Carnets y Certificados
      </h2>
    </div>
    <p class="text-xs text-ink-muted">
      Lista de revocaciones: <time datetime={revocaciones.ultimaActualizacion}>{revocaciones.ultimaActualizacion}</time>
    </p>
  </div>

  <p class="mt-4 text-sm text-ink-muted leading-relaxed">
    Comprueba si una credencial digital de <strong>Nivel 4</strong> o certificado de <strong>Nivel 3</strong> es auténtico
    sin exponer la identidad del militante ni consultar bases de datos externas. También admite lectura directa mediante enlace QR con fragmento privado <code>#token=...</code>.
  </p>

  <form id="form-verificador" class="mt-5 space-y-4">
    <div>
      <label for="token-carnet" class="block text-sm font-bold text-navy-900">
        Credencial digital (formato <code>PU1.&lt;carga&gt;.&lt;firma&gt;</code>)
      </label>
      <p id="token-ayuda" class="mt-1 text-xs text-ink-muted">
        Pega la cadena completa del carnet o usa una credencial de prueba para comprobar el verificador criptográfico.
      </p>
      <textarea
        id="token-carnet"
        name="token"
        rows="3"
        aria-describedby="token-ayuda"
        placeholder="PU1.eyJpZCI6IlBVLU40L..."
        required
        class="mt-2 w-full rounded-lg border border-ink-muted/60 bg-surface-page p-3 font-mono text-xs sm:text-sm text-ink"
      ></textarea>
    </div>

    <div class="flex flex-wrap gap-3">
      <button
        type="submit"
        class="btn inline-flex items-center gap-2 rounded-lg bg-navy-900 text-white px-5 py-2.5 text-sm font-bold hover:bg-navy-800 cursor-pointer"
      >
        <Icon name="shield" class="w-4 h-4 text-gold-300" />
        <span>Verificar firma Ed25519</span>
      </button>
      <button
        type="button"
        id="btn-cargar-demo"
        class="btn inline-flex items-center gap-2 rounded-lg bg-gold-400 text-navy-950 px-4 py-2.5 text-sm font-bold hover:bg-gold-300 cursor-pointer"
      >
        <Icon name="check" class="w-4 h-4" />
        <span>Cargar credencial DEMO válida</span>
      </button>
      <button
        type="button"
        id="btn-cargar-alterada"
        class="btn inline-flex items-center gap-2 rounded-lg bg-surface-page text-navy-900 border border-ink-muted/60 px-4 py-2.5 text-sm font-semibold hover:bg-surface-muted cursor-pointer"
      >
        <Icon name="x" class="w-4 h-4 text-rose-700" />
        <span>Probar credencial alterada</span>
      </button>
      <button
        type="button"
        id="btn-copiar-qr"
        class="btn inline-flex items-center gap-2 rounded-lg bg-surface-page text-navy-900 border border-ink-muted/60 px-4 py-2.5 text-sm font-semibold hover:bg-surface-muted cursor-pointer"
      >
        <Icon name="qr" class="w-4 h-4" />
        <span>Copiar enlace QR DEMO</span>
      </button>
    </div>
  </form>

  <div
    id="resultado-verificador"
    class="mt-5 rounded-xl border border-border bg-surface-page p-4 text-sm"
    aria-live="polite"
  >
    Ingresa una credencial y pulsa <strong>Verificar firma Ed25519</strong>.
  </div>
</section>

<script>
  import { verifyCarnetToken } from '../lib/crypto-carnet';

  const container = document.getElementById('verificador-carnet');
  const demoToken = container?.dataset.demoToken ?? '';
  let revocadosList: string[] = [];
  try {
    revocadosList = JSON.parse(container?.dataset.revocados ?? '[]');
  } catch {
    revocadosList = [];
  }

  const form = document.getElementById('form-verificador');
  const textarea = document.getElementById('token-carnet');
  const btnDemo = document.getElementById('btn-cargar-demo');
  const btnAlterada = document.getElementById('btn-cargar-alterada');
  const btnCopiarQr = document.getElementById('btn-copiar-qr');
  const resultadoEl = document.getElementById('resultado-verificador');

  function extractTokenFromLocation(): string | null {
    const hash = window.location.hash.startsWith('#') ? window.location.hash.slice(1) : window.location.hash;
    if (hash) {
      const hashParams = new URLSearchParams(hash);
      const hashToken = hashParams.get('token');
      if (hashToken) return hashToken.trim();
    }

    const searchParams = new URLSearchParams(window.location.search);
    const queryToken = searchParams.get('token');
    if (queryToken) {
      searchParams.delete('token');
      const remainingSearch = searchParams.toString();
      const cleanUrl = `${window.location.pathname}${remainingSearch ? `?${remainingSearch}` : ''}#token=${encodeURIComponent(queryToken)}`;
      window.history.replaceState(null, '', cleanUrl);
      return queryToken.trim();
    }

    return null;
  }

  async function runVerification() {
    if (!(textarea instanceof HTMLTextAreaElement) || !resultadoEl) return;
    const result = await verifyCarnetToken(textarea.value, revocadosList);

    resultadoEl.className = 'mt-5 rounded-xl border p-4 text-sm';

    if (result.status === 'valid') {
      resultadoEl.classList.add('border-emerald-700', 'bg-emerald-50', 'text-emerald-950');
      const nivelDesc =
        result.payload.nivel === 3
          ? 'Nivel 3 — Asamblea Dirigencial / Cantera (Escuela Política Certificada)'
          : 'Nivel 4 — Militancia Operativa (Carnet Digital)';

      resultadoEl.innerHTML = '';
      const title = document.createElement('p');
      title.className = 'font-bold text-base';
      title.textContent = result.isDemo
        ? '✓ FIRMA ED25519 VÁLIDA (CREDENCIAL DE DEMOSTRACIÓN)'
        : '✓ CREDENCIAL OFICIAL AUTÉNTICA Y VIGENTE';

      const list = document.createElement('dl');
      list.className = 'mt-2.5 grid gap-1.5 sm:grid-cols-2 text-xs sm:text-sm';
      const rows: [string, string][] = [
        ['Identificador', result.payload.id],
        ['Clave de firma (kid)', result.payload.kid],
        ['Rango', nivelDesc],
        ['Fecha de emisión', result.payload.emitido],
        ['Escuela Política', result.payload.escuelaCertificada ? 'Aprobada y certificada' : 'No requerida para Nivel 4'],
      ];
      for (const [k, v] of rows) {
        const dt = document.createElement('dt');
        dt.className = 'font-bold';
        dt.textContent = k;
        const dd = document.createElement('dd');
        dd.textContent = v;
        list.append(dt, dd);
      }
      resultadoEl.append(title, list);
      return;
    }

    if (result.status === 'revoked') {
      resultadoEl.classList.add('border-amber-700', 'bg-amber-50', 'text-amber-950');
      resultadoEl.textContent = `⚠ CREDENCIAL REVOCADA (${result.payload.id}): ${result.reason}`;
      return;
    }

    if (result.status === 'unsupported') {
      resultadoEl.classList.add('border-amber-700', 'bg-amber-50', 'text-amber-950');
      resultadoEl.textContent = `⚠ ${result.message}`;
      return;
    }

    resultadoEl.classList.add('border-rose-700', 'bg-rose-50', 'text-rose-950');
    resultadoEl.textContent = `✕ CREDENCIAL INVÁLIDA: ${result.reason}`;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    void runVerification();
  });

  btnDemo?.addEventListener('click', () => {
    if (textarea instanceof HTMLTextAreaElement) {
      textarea.value = demoToken;
      void runVerification();
    }
  });

  btnAlterada?.addEventListener('click', () => {
    if (textarea instanceof HTMLTextAreaElement) {
      const tampered = demoToken.slice(0, -4) + 'XXXX';
      textarea.value = tampered;
      void runVerification();
    }
  });

  btnCopiarQr?.addEventListener('click', async () => {
    const qrUrl = `${window.location.origin}${window.location.pathname}#token=${encodeURIComponent(demoToken)}`;
    if (!resultadoEl) return;
    resultadoEl.className = 'mt-5 rounded-xl border border-navy-900 bg-surface-page p-4 text-sm text-navy-900';
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(qrUrl);
        resultadoEl.textContent = '✓ Enlace QR DEMO copiado al portapapeles (con fragmento privado #token=).';
      } else {
        resultadoEl.textContent = `Enlace QR DEMO generado: ${qrUrl}`;
      }
    } catch {
      resultadoEl.textContent = `Enlace QR DEMO generado: ${qrUrl}`;
    }
  });

  const urlToken = extractTokenFromLocation();
  if (urlToken && textarea instanceof HTMLTextAreaElement) {
    textarea.value = urlToken;
    void runVerification();
  }
</script>
