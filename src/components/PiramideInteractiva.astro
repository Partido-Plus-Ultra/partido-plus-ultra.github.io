---
import organigrama from '../data/organigrama.json';

const poderPorId = new Map(organigrama.poderes.map((p) => [p.id, p]));
---

<section class="bg-navy-950 text-white rounded-2xl p-6 sm:p-8 border-2 border-gold-400 shadow-lg" aria-labelledby="piramide-heading">
  <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 border-b border-navy-700 pb-5">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-gold-300">Mapa Orgánico Interactivo</p>
      <h2 id="piramide-heading" class="mt-1 text-2xl sm:text-3xl font-extrabold text-white">
        Los Tres Poderes y Cinco Niveles
      </h2>
    </div>
    <div class="flex flex-wrap gap-3 text-xs">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-navy-800 border border-gold-400/60 px-3 py-1.5 text-gold-300 font-semibold">
        <span aria-hidden="true">↑</span> {organigrama.partido.ejesGobernanza.ascendente}
      </span>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-navy-800 border border-slate-500 px-3 py-1.5 text-slate-200 font-semibold">
        <span aria-hidden="true">↓</span> {organigrama.partido.ejesGobernanza.descendente}
      </span>
    </div>
  </div>

  <ol class="mt-6 space-y-4">
    {organigrama.niveles.map((nivel) => {
      const poder = nivel.poderId ? poderPorId.get(nivel.poderId) : null;
      return (
        <li class="rounded-xl bg-navy-900/90 border border-navy-700 hover:border-gold-400 transition-colors p-5">
          <div class="grid gap-4 lg:grid-cols-12 lg:items-start">
            <div class="lg:col-span-4 flex flex-col gap-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-block rounded-md bg-gold-400 text-navy-950 font-extrabold text-xs px-2.5 py-1 uppercase tracking-wide">
                  Nivel {nivel.nivel}
                </span>
                {poder ? (
                  <span class="inline-block rounded-md bg-navy-800 border border-gold-400/50 text-gold-300 font-semibold text-xs px-2.5 py-1">
                    {poder.nombre} ({poder.subtitulo})
                  </span>
                ) : (
                  <span class="inline-block rounded-md bg-navy-800 border border-slate-600 text-slate-300 font-semibold text-xs px-2.5 py-1">
                    Base Orgánica y Social
                  </span>
                )}
              </div>
              <h3 class="text-lg font-bold text-white mt-1">
                {nivel.nombre} — <span class="text-gold-300">{nivel.etiqueta}</span>
              </h3>
              <div class="mt-1 flex flex-wrap gap-2 text-xs">
                <span class={nivel.puedePostular
                  ? 'rounded px-2 py-0.5 bg-emerald-950 text-emerald-200 border border-emerald-600 font-semibold'
                  : 'rounded px-2 py-0.5 bg-amber-950 text-amber-200 border border-amber-600 font-semibold'}>
                  {nivel.puedePostular ? 'Única cantera electoral' : 'No postula a cargos'}
                </span>
                <span class={nivel.puedeTenerEmpresas
                  ? 'rounded px-2 py-0.5 bg-slate-800 text-slate-200 border border-slate-600 font-semibold'
                  : 'rounded px-2 py-0.5 bg-rose-950 text-rose-200 border border-rose-600 font-semibold'}>
                  {nivel.puedeTenerEmpresas ? 'Compatible con actividad privada' : 'Prohibido tener empresas'}
                </span>
              </div>
            </div>

            <div class="lg:col-span-8 space-y-2 text-sm text-slate-200">
              <p class="font-medium text-white">{nivel.composicion}</p>
              <ul class="list-disc pl-5 space-y-1 text-slate-300">
                {nivel.reglas.map((regla) => (
                  <li>{regla}</li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      );
    })}
  </ol>
</section>
