---
interface Props {
  class?: string;
  decorative?: boolean;
  title?: string;
}

const {
  class: className = 'w-10 h-10',
  decorative = true,
  title = 'Emblema institucional del Partido Plus Ultra',
} = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  class={className}
  aria-hidden={decorative ? 'true' : undefined}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : title}
>
  {!decorative && <title>{title}</title>}
  <path
    d="M32 3 L56 11 V31 C56 46 45.5 56.5 32 61 C18.5 56.5 8 46 8 31 V11 Z"
    fill="#061838"
    stroke="#D4AF37"
    stroke-width="2.2"
    stroke-linejoin="round"
  />
  <path
    d="M32 7 L52 13.7 V30.8 C52 43.3 43.2 52.3 32 56.4 C20.8 52.3 12 43.3 12 30.8 V13.7 Z"
    fill="#0A224E"
    stroke="#F2C94C"
    stroke-width="0.9"
    stroke-opacity="0.7"
    stroke-linejoin="round"
  />
  <!-- Estrella cívica superior -->
  <polygon
    points="32,10.5 33.4,14.2 37.3,14.2 34.2,16.5 35.4,20.2 32,17.9 28.6,20.2 29.8,16.5 26.7,14.2 30.6,14.2"
    fill="#F2C94C"
  />
  <!-- Columnas "Plus Ultra" -->
  <g fill="#D4AF37" opacity="0.9">
    <rect x="16.5" y="21" width="4" height="20" rx="0.6" />
    <rect x="15.5" y="20" width="6" height="1.8" rx="0.5" />
    <rect x="15.5" y="40.5" width="6" height="1.8" rx="0.5" />
    <rect x="43.5" y="21" width="4" height="20" rx="0.6" />
    <rect x="42.5" y="20" width="6" height="1.8" rx="0.5" />
    <rect x="42.5" y="40.5" width="6" height="1.8" rx="0.5" />
  </g>
  <!-- Horizonte andino geométrico -->
  <path
    d="M17 48 L26 40.5 L32 45 L38 40.5 L47 48"
    fill="none"
    stroke="#F2C94C"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- Monograma PU -->
  <text
    x="32"
    y="35.5"
    text-anchor="middle"
    font-family="Georgia, 'Times New Roman', serif"
    font-weight="700"
    font-size="14.5"
    letter-spacing="0.8"
    fill="#FFFFFF"
  >PU</text>
</svg>
