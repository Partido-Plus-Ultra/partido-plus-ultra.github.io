---
import QRCode from 'qrcode';
import EmblemaSvg from './EmblemaSvg.astro';
import Icon from './Icon.astro';
import { DEMO_SAMPLE_TOKEN } from '../lib/crypto-carnet';
import { SITE_URL, withBase } from '../lib/url';

const qrTargetUrl = new URL(withBase('/militancia/'), SITE_URL).toString() + `#token=${encodeURIComponent(DEMO_SAMPLE_TOKEN)}`;
const qrSvg = await QRCode.toString(qrTargetUrl, {
  type: 'svg',
  errorCorrectionLevel: 'L',
  margin: 1,
  color: {
    dark: '#061838',
    light: '#ffffff',
  },
});
---

<aside class="rounded-2xl border-2 border-gold-400 bg-navy-950 text-white p-6 shadow-xl" aria-labelledby="maqueta-carnet-heading">
  <div class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-navy-700">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-navy-800 border border-gold-400/70 px-3 py-1 text-xs font-bold uppercase tracking-wider text-gold-300">
      <Icon name="qr" class="w-3.5 h-3.5" />
      <span>Muestra Referencial · Fase 2</span>
    </span>
    <span class="text-xs text-slate-300 font-mono">Ed25519 · kid: demo-2026-01</span>
  </div>

  <h3 id="maqueta-carnet-heading" class="mt-4 text-lg font-bold text-white">
    Carnet Digital Anónimo — Nivel 4
  </h3>
  <p class="mt-1 text-xs text-slate-300 leading-relaxed">
    Diseño previsto para Fase 2. Este código QR es real y escaneable: apunta a la credencial de demostración para probar el verificador al instante.
  </p>

  <!-- Tarjeta visual del carnet -->
  <div class="mt-5 rounded-xl bg-gradient-to-br from-navy-900 via-navy-800 to-navy-950 border border-gold-400 p-5 shadow-inner grid gap-5 sm:grid-cols-12 items-center">
    <div class="sm:col-span-8 space-y-3">
      <div class="flex items-center gap-3">
        <EmblemaSvg class="w-10 h-10 shrink-0" decorative={true} />
        <div>
          <p class="font-serif text-sm font-bold text-gold-300">PARTIDO PLUS ULTRA</p>
          <p class="text-[11px] uppercase tracking-widest text-slate-300">Militancia Operativa · Nivel 4</p>
        </div>
      </div>

      <dl class="grid grid-cols-2 gap-x-4 gap-y-2 pt-2 border-t border-navy-700 text-xs">
        <div>
          <dt class="text-slate-400 uppercase tracking-wider text-[10px]">Código</dt>
          <dd class="font-mono font-bold text-white">PU-N4-DEMO-7K9P</dd>
        </div>
        <div>
          <dt class="text-slate-400 uppercase tracking-wider text-[10px]">Identidad</dt>
          <dd class="font-semibold text-gold-300">Anónima (Cero PII)</dd>
        </div>
        <div>
          <dt class="text-slate-400 uppercase tracking-wider text-[10px]">Estado</dt>
          <dd class="font-semibold text-emerald-300">Credencial DEMO</dd>
        </div>
        <div>
          <dt class="text-slate-400 uppercase tracking-wider text-[10px]">Emisión</dt>
          <dd class="font-mono text-slate-200">2026-11-23</dd>
        </div>
      </dl>
    </div>

    <div class="sm:col-span-4 flex flex-col items-center">
      <div
        class="w-36 h-36 rounded-lg bg-white p-2 border-2 border-gold-400 shadow"
        role="img"
        aria-label="Código QR escaneable de la credencial de demostración PU-N4-DEMO-7K9P"
        set:html={qrSvg}
      />
      <span class="mt-1.5 text-[10px] uppercase tracking-wider text-gold-300 font-semibold">
        Escanea para validar
      </span>
    </div>
  </div>
</aside>
