---
interface Props {
  class?: string;
}

const { class: className = 'w-full h-auto block' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 600 375"
  class={className}
  role="img"
  aria-label="Ilustración institucional de biblioteca doctrinal, libros de estudio y pergamino sellado de la Escuela Política"
>
  <rect width="600" height="375" fill="#061838" />
  <!-- Arcos clásicos de biblioteca -->
  <g fill="none" stroke="#1E3A6E" stroke-width="2">
    <path d="M90 340 V155 A110 110 0 0 1 310 155 V340" />
    <path d="M110 340 V160 A90 90 0 0 1 290 160 V340" />
    <path d="M290 340 V155 A110 110 0 0 1 510 155 V340" />
    <path d="M310 340 V160 A90 90 0 0 1 490 160 V340" />
    <line x1="65" y1="340" x2="535" y2="340" stroke="#D4AF37" stroke-opacity="0.55" />
  </g>
  <!-- Rayos y estrella superior -->
  <g stroke="#D4AF37" stroke-opacity="0.35" stroke-width="1.2">
    <line x1="300" y1="54" x2="230" y2="105" />
    <line x1="300" y1="54" x2="370" y2="105" />
    <line x1="300" y1="54" x2="300" y2="115" />
  </g>
  <polygon
    points="300,32 305,46 320,46 308,55 312,69 300,60 288,69 292,55 280,46 295,46"
    fill="#F2C94C"
  />
  <!-- Libros apilados a la izquierda -->
  <g stroke="#D4AF37" stroke-width="2.2" stroke-linejoin="round">
    <rect x="125" y="275" width="165" height="36" rx="4" fill="#0A224E" />
    <line x1="142" y1="284" x2="265" y2="284" stroke="#F2C94C" stroke-width="1.4" />
    <rect x="140" y="237" width="142" height="34" rx="4" fill="#102F66" />
    <line x1="156" y1="246" x2="262" y2="246" stroke="#F2C94C" stroke-width="1.4" />
    <rect x="155" y="201" width="120" height="32" rx="4" fill="#0A224E" />
    <line x1="170" y1="211" x2="255" y2="211" stroke="#F2C94C" stroke-width="1.4" />
  </g>
  <!-- Pergamino sellado a la derecha -->
  <g>
    <rect x="330" y="145" width="136" height="162" rx="6" fill="#F7F4E8" stroke="#D4AF37" stroke-width="2.5" />
    <path d="M322 155 C322 145, 338 145, 338 155 V165 H322 Z" fill="#D4AF37" />
    <path d="M458 297 C458 307, 474 307, 474 297 V287 H458 Z" fill="#D4AF37" />
    <g stroke="#8A6500" stroke-width="1.6" stroke-opacity="0.65">
      <line x1="354" y1="178" x2="442" y2="178" />
      <line x1="354" y1="196" x2="442" y2="196" />
      <line x1="354" y1="214" x2="442" y2="214" />
      <line x1="354" y1="232" x2="424" y2="232" />
    </g>
    <!-- Sello dorado -->
    <circle cx="422" cy="272" r="18" fill="#061838" stroke="#D4AF37" stroke-width="2.2" />
    <circle cx="422" cy="272" r="11" fill="none" stroke="#F2C94C" stroke-width="1.2" />
    <path d="M414 287 L410 318 L422 310 L434 318 L430 287" fill="#D4AF37" />
  </g>
</svg>
