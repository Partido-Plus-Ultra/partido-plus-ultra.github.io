---
import '@fontsource/libre-baskerville/400.css';
import '@fontsource/libre-baskerville/700.css';
import '@fontsource-variable/plus-jakarta-sans';
import baskerville700Url from '@fontsource/libre-baskerville/files/libre-baskerville-latin-700-normal.woff2?url';
import jakartaVarUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_URL, withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/img/og-whatsapp-1200x630.jpg',
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).toString();
const ogImageUrl = new URL(withBase(ogImage), Astro.site ?? SITE_URL).toString();
const fullTitle = `${title} | Partido Plus Ultra`;
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- Preload tipografías críticas auto-alojadas -->
    <link rel="preload" href={baskerville700Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakartaVarUrl} as="font" type="font/woff2" crossorigin />

    <!-- OpenGraph / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Partido Plus Ultra" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="min-h-dvh flex flex-col bg-surface-page text-ink antialiased">
    <a href="#contenido-principal" class="skip-link visually-hidden">
      Saltar al contenido principal
    </a>

    <SiteHeader />

    <main class="flex-1">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
