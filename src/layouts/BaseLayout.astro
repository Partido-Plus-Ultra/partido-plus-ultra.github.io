---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_URL, withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const {
  title,
  description,
  ogImage = '/img/infografia-estructura-partido.jpg',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).toString();
const ogImageUrl = new URL(withBase(ogImage), Astro.site ?? SITE_URL).toString();
const fullTitle = `${title} | Partido Plus Ultra`;
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- OpenGraph / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Partido Plus Ultra" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="min-h-dvh flex flex-col bg-surface text-ink antialiased">
    <a href="#contenido-principal" class="skip-link visually-hidden">
      Saltar al contenido principal
    </a>

    <SiteHeader />

    <main class="flex-1">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
