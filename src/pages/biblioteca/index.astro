---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../lib/url';

const documentos = (await getCollection('documentos')).sort((a, b) =>
  b.data.fecha.localeCompare(a.data.fecha)
);
---

<BaseLayout
  title="Biblioteca Doctrinal"
  description="Libros, guías orgánicas, reglamentos y documentos técnicos publicados por el Poder Constitucional del Partido Plus Ultra."
>
  <div class="max-w-7xl mx-auto px-4 py-10 space-y-8">
    <header class="border-b border-border pb-6 space-y-3">
      <p class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-gold-700">
        <Icon name="book" class="w-4 h-4" />
        <span>Poder Constitucional · Nivel 2</span>
      </p>
      <h1 id="contenido-principal" tabindex="-1" class="font-bold text-navy-900">
        Biblioteca Doctrinal y Normativa
      </h1>
      <p class="text-base text-ink-muted max-w-3xl">
        Todo material de estudio, reglamento interno y documento público producido para garantizar la unidad doctrinal sin secretos.
      </p>
    </header>

    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 rounded-xl border border-border bg-white p-4 sm:p-5 shadow-sm">
      <div class="w-full sm:w-96">
        <label for="buscar-doc" class="block text-sm font-bold text-navy-900">Buscar en la biblioteca</label>
        <input
          id="buscar-doc"
          type="search"
          placeholder="Ej. Estructura, Escuela Política, Ed25519..."
          class="mt-1.5 w-full rounded-lg border border-ink-muted/60 bg-surface-page px-3 py-2 text-sm text-ink"
        />
      </div>
      <p id="docs-estado" class="text-sm font-medium text-ink-muted" aria-live="polite">
        Mostrando {documentos.length} de {documentos.length} documentos disponibles.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {documentos.map((doc) => (
        <article
          data-doc-card
          data-search={`${doc.data.titulo} ${doc.data.categoria} ${doc.data.resumen} ${doc.data.organoEmisor}`.toLowerCase()}
          class="rounded-xl border border-border border-s-4 border-s-navy-900 bg-white p-6 shadow-sm flex flex-col justify-between hover:border-s-gold-400 transition-colors"
        >
          <div>
            <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
              <span class="rounded bg-navy-900 text-gold-300 px-2.5 py-0.5">{doc.data.categoria}</span>
              <span class="rounded bg-surface-muted border border-border text-navy-900 px-2.5 py-0.5">v{doc.data.version}</span>
              <time datetime={doc.data.fecha} class="text-ink-muted">{doc.data.fecha}</time>
            </div>
            <h2 class="mt-3 text-xl font-bold text-navy-900">{doc.data.titulo}</h2>
            <p class="mt-2 text-sm text-ink-muted leading-relaxed">{doc.data.resumen}</p>
          </div>
          <div class="mt-5 pt-4 border-t border-border flex flex-wrap gap-4 items-center justify-between text-sm">
            <a
              href={withBase(`/biblioteca/${doc.id}/`)}
              class="inline-flex items-center gap-1.5 font-bold text-navy-900 underline underline-offset-4 hover:text-navy-700"
            >
              <span>Leer documento completo</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>
            {doc.data.pdfUrl && (
              <a
                href={withBase(doc.data.pdfUrl)}
                class="inline-flex items-center gap-1.5 rounded-md bg-surface-muted border border-border px-3 py-1.5 text-xs font-bold text-navy-900 hover:bg-slate-200"
              >
                <Icon name="download" class="w-3.5 h-3.5" />
                <span>Descargar PDF</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const inputDoc = document.getElementById('buscar-doc');
  const estadoDocs = document.getElementById('docs-estado');
  const cards = Array.from(document.querySelectorAll('[data-doc-card]'));

  inputDoc?.addEventListener('input', () => {
    const q = inputDoc instanceof HTMLInputElement ? inputDoc.value.trim().toLowerCase() : '';
    let visible = 0;
    for (const card of cards) {
      const hay = card.getAttribute('data-search') || '';
      const match = !q || hay.includes(q);
      card.toggleAttribute('hidden', !match);
      if (match) visible += 1;
    }
    if (estadoDocs) {
      estadoDocs.textContent = `Mostrando ${visible} de ${cards.length} documentos disponibles.`;
    }
  });
</script>
