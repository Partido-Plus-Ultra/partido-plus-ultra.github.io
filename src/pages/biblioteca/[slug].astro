---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompartirWhatsapp from '../../components/CompartirWhatsapp.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const documentos = await getCollection('documentos');
  return documentos.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<BaseLayout title={doc.data.titulo} description={doc.data.resumen}>
  <article class="max-w-4xl mx-auto px-4 py-10">
    <nav class="no-print mb-6 text-sm" aria-label="Ruta de documento">
      <a href={withBase('/biblioteca/')} class="font-bold text-navy-900 underline underline-offset-4">
        ← Volver a la Biblioteca Doctrinal
      </a>
    </nav>

    <header class="rounded-2xl bg-white border border-border border-t-4 border-t-gold-400 p-6 sm:p-8 shadow-sm space-y-3">
      <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
        <span class="rounded bg-navy-900 text-gold-300 px-2.5 py-0.5">{doc.data.categoria}</span>
        <span class="rounded bg-surface-muted border border-border text-navy-900 px-2.5 py-0.5">Versión {doc.data.version}</span>
        <span class="text-ink-muted">Emisor: {doc.data.organoEmisor}</span>
        <time datetime={doc.data.fecha} class="text-ink-muted">{doc.data.fecha}</time>
      </div>
      <h1 id="contenido-principal" tabindex="-1" class="font-bold text-navy-900">
        {doc.data.titulo}
      </h1>
      <p class="text-base text-ink-muted leading-relaxed">{doc.data.resumen}</p>
      <div class="no-print pt-2 flex flex-wrap gap-3">
        {doc.data.pdfUrl && (
          <a
            href={withBase(doc.data.pdfUrl)}
            class="btn inline-flex items-center gap-2 rounded-lg bg-navy-900 text-white px-4 py-2.5 text-sm font-bold hover:bg-navy-800"
          >
            <Icon name="download" class="w-4 h-4 text-gold-300" />
            <span>Descargar archivo PDF original</span>
          </a>
        )}
        <CompartirWhatsapp
          mensaje={`Lee el documento "${doc.data.titulo}" del Partido Plus Ultra (Perú):`}
        />
      </div>
    </header>

    <div class="prose-doctrina mt-8 rounded-2xl bg-white border border-border p-6 sm:p-10 shadow-sm text-ink leading-relaxed">
      <Content />
    </div>
  </article>
</BaseLayout>
