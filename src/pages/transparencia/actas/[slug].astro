---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CompartirWhatsapp from '../../../components/CompartirWhatsapp.astro';
import Icon from '../../../components/Icon.astro';
import { REPO_URL, withBase } from '../../../lib/url';

export async function getStaticPaths() {
  const actas = await getCollection('actas');
  return actas.map((acta) => ({
    params: { slug: acta.id },
    props: { acta },
  }));
}

const { acta } = Astro.props;
const { Content } = await render(acta);
---

<BaseLayout title={`Acta ${acta.data.numero} — ${acta.data.titulo}`} description={acta.data.resumen}>
  <article class="max-w-4xl mx-auto px-4 py-10">
    <nav class="no-print mb-6 text-sm" aria-label="Ruta del acta">
      <a href={withBase('/transparencia/')} class="font-bold text-navy-900 underline underline-offset-4">
        ← Volver al Portal de Transparencia
      </a>
    </nav>

    <header class="rounded-2xl bg-white border border-border border-t-4 border-t-gold-400 p-6 sm:p-8 shadow-sm space-y-3">
      <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
        <span class="rounded bg-navy-900 text-gold-300 px-2.5 py-0.5">Acta {acta.data.numero}</span>
        <span class="rounded bg-surface-muted border border-border text-navy-900 px-2.5 py-0.5">{acta.data.organo}</span>
        <span class="rounded bg-emerald-50 border border-emerald-600 text-emerald-900 px-2.5 py-0.5">{acta.data.estado}</span>
        <time datetime={acta.data.fecha} class="text-ink-muted">{acta.data.fecha}</time>
      </div>
      <h1 id="contenido-principal" tabindex="-1" class="font-bold text-navy-900">
        {acta.data.titulo}
      </h1>
      <p class="text-base text-ink-muted leading-relaxed">{acta.data.resumen}</p>
      <div class="no-print pt-2 flex flex-wrap gap-3">
        <a
          href={`${REPO_URL}/blob/main/src/content/actas/${acta.id}.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn inline-flex items-center gap-2 rounded-lg bg-navy-900 text-white px-4 py-2.5 text-sm font-bold hover:bg-navy-800"
        >
          <Icon name="github" class="w-4 h-4 text-gold-300" />
          <span>Auditar archivo fuente en GitHub</span>
        </a>
        <CompartirWhatsapp
          mensaje={`Consulta el Acta ${acta.data.numero} (${acta.data.titulo}) del Partido Plus Ultra:`}
        />
      </div>
    </header>

    <div class="prose-doctrina mt-8 rounded-2xl bg-white border border-border p-6 sm:p-10 shadow-sm text-ink leading-relaxed">
      <Content />
    </div>
  </article>
</BaseLayout>
