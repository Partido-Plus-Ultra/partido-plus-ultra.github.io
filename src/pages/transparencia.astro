---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PanelTesoreria from '../components/PanelTesoreria.astro';
import Icon from '../components/Icon.astro';
import visualTransparencia from '../assets/img/visual-transparencia.webp';
import organigrama from '../data/organigrama.json';
import tesoreria from '../data/tesoreria.json';
import { normalizeSearchText } from '../lib/search';
import type { LibroTesoreria } from '../lib/tesoreria-metrics';
import { REPO_URL, withBase } from '../lib/url';

const actas = (await getCollection('actas')).sort((a, b) =>
  b.data.fecha.localeCompare(a.data.fecha)
);
---

<BaseLayout
  title="Portal de Transparencia"
  description="Cuentas abiertas en tiempo real, actas públicas, registro de autoridades N1/N2/N3 y protocolo de supervisión ética del Partido Plus Ultra."
>
  <div class="max-w-7xl mx-auto px-4 py-10 space-y-14">
    <!-- Cabecera editorial 60/40 -->
    <header class="rounded-2xl bg-navy-900 text-white border-2 border-gold-400 p-6 sm:p-8 lg:p-10 grid gap-8 lg:grid-cols-12 items-center shadow-lg">
      <div class="lg:col-span-7 space-y-3">
        <p class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-gold-300">
          <Icon name="scale" class="w-4 h-4" />
          <span>Auditoría Pública Abierta</span>
        </p>
        <h1 id="contenido-principal" tabindex="-1" class="font-bold text-white">
          Portal de Transparencia y Cuentas Claras
        </h1>
        <p class="text-base text-slate-200 leading-relaxed max-w-2xl">
          Toda cifra, acta y regla de este portal está respaldada en un repositorio Git público. Ningún movimiento financiero puede alterarse sin dejar rastro verificable en el historial.
        </p>
        <div class="pt-2">
          <a
            href={`${REPO_URL}/commits/main`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn inline-flex items-center gap-2 rounded-lg bg-gold-400 text-navy-950 px-5 py-2.5 text-sm font-bold hover:bg-gold-300"
          >
            <Icon name="github" class="w-4 h-4" />
            <span>Auditar historial de commits en GitHub</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-xl overflow-hidden border border-gold-400/70 bg-navy-950 shadow-inner">
          <Picture
            src={visualTransparencia}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            widths={[480, 800]}
            sizes="(max-width: 1024px) 100vw, 40vw"
            alt="Ilustración institucional de balanza cívica y libro contable abierto."
            loading="eager"
            class="w-full h-auto block"
          />
        </div>
      </div>
    </header>

    <!-- 1. Tesorería Abierta -->
    <PanelTesoreria libro={tesoreria as LibroTesoreria} />

    <!-- 2. Registro Público de Autoridades -->
    <section aria-labelledby="autoridades-heading" class="space-y-4">
      <div>
        <h2 id="autoridades-heading" class="text-2xl sm:text-3xl font-bold text-navy-900">
          Registro Público de Autoridades y Prohibición de Empresas (Nivel 1 y Nivel 2)
        </h2>
        <p class="mt-1 text-sm text-ink-muted">
          Los cargos de Nivel 1 y Nivel 2 no pueden postular a elecciones públicas ni mantener empresas, garantizando imparcialidad moral y doctrinal.
        </p>
      </div>

      <div tabindex="0" role="region" aria-labelledby="autoridades-caption" class="table-wrapper">
        <table class="pu-table pu-table-autoridades">
          <caption id="autoridades-caption">
            Plazas orgánicas de dirección, custodia doctrinal y administración
          </caption>
          <thead>
            <tr>
              <th scope="col">Cargo</th>
              <th scope="col">Nivel</th>
              <th scope="col">Mandato / Rotación</th>
              <th scope="col">Titular</th>
              <th scope="col">Estado</th>
              <th scope="col">Declaración de No-Empresas</th>
            </tr>
          </thead>
          <tbody>
            {organigrama.registroAutoridades.map((aut) => (
              <tr>
                <th scope="row">{aut.cargo}</th>
                <td>Nivel {aut.nivel}</td>
                <td>{aut.mandato}</td>
                <td>{aut.titular}</td>
                <td>{aut.estado}</td>
                <td>{aut.declaracionNoEmpresas}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 3. Supervisión y Canal Ético -->
    <section aria-labelledby="supervision-heading" class="rounded-2xl bg-civic-grid text-white p-6 sm:p-8 border-2 border-gold-400 shadow-lg">
      <p class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-gold-300">
        <Icon name="shield" class="w-4 h-4" />
        <span>Poder Constitucional · Nivel 2</span>
      </p>
      <h2 id="supervision-heading" class="mt-1.5 text-2xl sm:text-3xl font-bold text-white">
        Supervisión Interna y Protocolo de Sanciones
      </h2>
      <div class="mt-5 grid gap-6 md:grid-cols-3 text-sm text-slate-200">
        <div class="rounded-xl bg-navy-950/85 p-5 border border-gold-400/40">
          <h3 class="font-bold text-gold-300 flex items-center gap-2 text-base">
            <Icon name="scale" class="w-4 h-4" />
            <span>Vigilancia de Todos los Niveles</span>
          </h3>
          <p class="mt-2 leading-relaxed">
            Los Supervisores del Nivel 2 fiscalizan el cumplimiento estricto de los reglamentos desde el Nivel 1 hasta el Nivel 5, evitando desviaciones ideológicas o privilegios.
          </p>
        </div>
        <div class="rounded-xl bg-navy-950/85 p-5 border border-gold-400/40">
          <h3 class="font-bold text-gold-300 flex items-center gap-2 text-base">
            <Icon name="lock" class="w-4 h-4" />
            <span>Cero Atajos en la Escuela Política</span>
          </h3>
          <p class="mt-2 leading-relaxed">
            Cualquier intento de ingreso al Nivel 3 o postulación electoral sin cumplir los 6 meses obligatorios de Escuela Política es nulo de pleno derecho.
          </p>
        </div>
        <div class="rounded-xl bg-navy-950/85 p-5 border border-gold-400/40">
          <h3 class="font-bold text-gold-300 flex items-center gap-2 text-base">
            <Icon name="alert" class="w-4 h-4" />
            <span>Canal Ético Público (Fase 2)</span>
          </h3>
          <p class="mt-2 leading-relaxed">
            Se habilitará el canal formal de alertas ante el Poder Constitucional una vez publicada el acta de instalación de los primeros 5 Guardianes.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. Actas Públicas -->
    <section aria-labelledby="actas-heading" class="space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <h2 id="actas-heading" class="text-2xl sm:text-3xl font-bold text-navy-900">
            Actas Públicas del Partido
          </h2>
          <p class="mt-1 text-sm text-ink-muted">
            Acuerdos formales publicados cronológicamente en formato expediente auditable.
          </p>
        </div>
        <div class="w-full sm:w-72">
          <label for="buscar-acta" class="block text-xs font-bold uppercase tracking-wider text-navy-900">
            Buscar acta
          </label>
          <input
            id="buscar-acta"
            type="search"
            placeholder="Filtrar por número, órgano o tema..."
            class="mt-1 w-full rounded-lg border border-ink-muted/60 bg-white px-3 py-2 text-sm text-ink"
          />
        </div>
      </div>

      <p id="actas-estado" class="text-sm font-medium text-ink-muted" aria-live="polite">
        Mostrando {actas.length} de {actas.length} actas publicadas.
      </p>

      <div class="grid gap-4">
        {actas.map((acta) => (
          <article
            data-acta-card
            data-search={normalizeSearchText(`${acta.data.numero} ${acta.data.titulo} ${acta.data.organo} ${acta.data.resumen}`)}
            class="rounded-xl border border-border border-s-4 border-s-gold-400 bg-white p-5 sm:p-6 shadow-sm"
          >
            <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
              <span class="inline-flex items-center gap-1 rounded bg-navy-900 text-gold-300 px-2.5 py-0.5">
                <Icon name="document" class="w-3.5 h-3.5" />
                <span>Acta {acta.data.numero}</span>
              </span>
              <span class="rounded bg-surface-muted border border-border text-navy-900 px-2.5 py-0.5">{acta.data.organo}</span>
              <time datetime={acta.data.fecha} class="text-ink-muted">{acta.data.fecha}</time>
            </div>
            <h3 class="mt-2.5 text-lg sm:text-xl font-bold text-navy-900">{acta.data.titulo}</h3>
            <p class="mt-1.5 text-sm text-ink-muted leading-relaxed">{acta.data.resumen}</p>
            <div class="mt-4 pt-3 border-t border-border">
              <a
                href={withBase(`/transparencia/actas/${acta.id}/`)}
                class="inline-flex items-center gap-1.5 text-sm font-bold text-navy-900 underline underline-offset-4 hover:text-navy-700"
              >
                <span>Leer acta completa</span>
                <Icon name="arrow-right" class="w-4 h-4" />
              </a>
            </div>
          </article>
        ))}
      </div>
      <div
        id="actas-vacio"
        hidden
        class="rounded-xl border border-border bg-white p-6 text-center space-y-3"
      >
        <p class="text-sm font-medium text-ink-muted">
          No hay actas que coincidan con tu búsqueda.
        </p>
        <button
          type="button"
          id="btn-limpiar-actas"
          class="btn rounded-lg bg-navy-900 text-white px-4 py-2 text-sm font-bold hover:bg-navy-800 cursor-pointer"
        >
          Limpiar búsqueda
        </button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { normalizeSearchText } from '../lib/search';

  const inputActa = document.getElementById('buscar-acta');
  const estadoActas = document.getElementById('actas-estado');
  const vacioActas = document.getElementById('actas-vacio');
  const btnLimpiarActas = document.getElementById('btn-limpiar-actas');
  const cards = Array.from(document.querySelectorAll('[data-acta-card]'));

  function applyActasFilter() {
    const q = inputActa instanceof HTMLInputElement ? normalizeSearchText(inputActa.value) : '';
    let visible = 0;
    for (const card of cards) {
      const hay = card.getAttribute('data-search') || '';
      const match = !q || hay.includes(q);
      card.toggleAttribute('hidden', !match);
      if (match) visible += 1;
    }
    vacioActas?.toggleAttribute('hidden', visible > 0);
    if (estadoActas) {
      estadoActas.textContent =
        visible === 0
          ? `Sin coincidencias (0 de ${cards.length} actas publicadas).`
          : `Mostrando ${visible} de ${cards.length} actas publicadas.`;
    }
  }

  inputActa?.addEventListener('input', applyActasFilter);
  btnLimpiarActas?.addEventListener('click', () => {
    if (inputActa instanceof HTMLInputElement) {
      inputActa.value = '';
      applyActasFilter();
      inputActa.focus();
    }
  });
</script>
