---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AccordionFaq, { type FaqItem } from '../components/AccordionFaq.astro';
import CompartirWhatsapp from '../components/CompartirWhatsapp.astro';
import EmblemaSvg from '../components/EmblemaSvg.astro';
import Icon from '../components/Icon.astro';
import heroImg from '../assets/img/hero-amanecer-civico.webp';
import avanceCiudadano from '../data/avance-ciudadano.json';
import organigrama from '../data/organigrama.json';
import tesoreria from '../data/tesoreria.json';
import type { LibroTesoreria } from '../lib/tesoreria-metrics';
import { calcularResumen, formatearMoneda } from '../lib/tesoreria-metrics';
import { REPO_URL, withBase } from '../lib/url';

const documentos = await getCollection('documentos');
const actas = await getCollection('actas');
const resumenTesoreria = calcularResumen(tesoreria as LibroTesoreria);
const totalBaseYMilitancia =
  organigrama.arranqueFundacional.grupoFundadorTotal +
  organigrama.arranqueFundacional.baseInicialSimpatizantes +
  avanceCiudadano.militantesDigitalesVerificados;

const faqInicio: FaqItem[] = [
  {
    pregunta: '¿Cómo funciona la inscripción anónima (Nivel 4)?',
    respuesta:
      'Para proteger al militante operativo frente a represalias, en la Fase 2 la web emitirá carnets digitales pseudónimos (PU-N4) verificables criptográficamente con Ed25519 sin publicar nombres ni DNI en el repositorio. Quienes deseen permanecer en Nivel 4 pueden hacerlo sin obligación de postular a cargos públicos.',
  },
  {
    pregunta: '¿Qué requisitos exige la Escuela Política para ascender a Nivel 3?',
    respuesta:
      'Es obligatorio aprobar un mínimo de 6 meses continuos de formación doctrinal (sin atajos ni exoneraciones) ante docentes exclusivos del Nivel 1 y Nivel 2, además de evaluación oral/sincrónica y verificación de antecedentes antes de ingresar a la Asamblea Dirigencial (única cantera electoral).',
  },
  {
    pregunta: '¿Cómo se auditan los fondos y acuerdos del partido?',
    respuesta:
      'Todas las cuentas contables, el registro de autoridades y las actas oficiales se publican en código abierto con historial verificable de cambios en GitHub. El balance de tesorería inicia en S/ 0.00 reales hasta que el Poder Constitucional registre aportes formales bancarizados.',
  },
];
---

<BaseLayout
  title="Inicio"
  description="Portal oficial de transparencia, doctrina, estructura en tres poderes y cinco niveles del Partido Plus Ultra (Perú)."
>
  <!-- Hero Editorial Inmersivo -->
  <section class="relative overflow-hidden bg-navy-950 text-white border-b-4 border-gold-400">
    <Picture
      src={heroImg}
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      widths={[800, 1280, 1600]}
      sizes="100vw"
      alt=""
      fetchpriority="high"
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-85"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-navy-950/95 via-navy-900/80 to-navy-950/35"
      aria-hidden="true"
    ></div>

    <div class="relative max-w-7xl mx-auto px-4 py-14 sm:py-20 lg:py-24">
      <div class="max-w-2xl space-y-5">
        <div class="flex flex-wrap items-center gap-3">
          <EmblemaSvg class="w-12 h-12 shrink-0" decorative={true} />
          <p class="inline-flex items-center gap-2 rounded-full bg-navy-900/90 border border-gold-400/80 px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-gold-300">
            <span>Infraestructura Pública · Perú · Costo S/ 0.00</span>
          </p>
        </div>

        <h1 id="contenido-principal" tabindex="-1" class="font-bold tracking-tight text-white">
          Partido Plus Ultra: Transparencia Total, Orden y Valores
        </h1>

        <div class="space-y-2.5 text-base sm:text-lg text-slate-200 leading-relaxed">
          <p>{organigrama.partido.identidad.resumen}</p>
          <p class="text-sm sm:text-base text-slate-300">
            Trabajamos con orden, cuentas abiertas y mérito técnico para erradicar la corrupción estatal e impulsar el desarrollo productivo del Perú.
          </p>
        </div>

        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href={withBase('/transparencia/')}
            class="btn inline-flex items-center gap-2 rounded-lg bg-gold-400 text-navy-950 font-bold px-5 py-3 text-sm sm:text-base hover:bg-gold-300 shadow-md"
          >
            <Icon name="ledger" class="w-4 h-4" />
            <span>Auditar Transparencia y Cuentas</span>
          </a>
          <a
            href={withBase('/estructura/')}
            class="btn inline-flex items-center gap-2 rounded-lg bg-navy-900/90 text-white border border-gold-400 font-semibold px-5 py-3 text-sm sm:text-base hover:bg-navy-800"
          >
            <Icon name="columns" class="w-4 h-4 text-gold-300" />
            <span>Conocer los 3 Poderes y 5 Niveles</span>
          </a>
        </div>
      </div>

      <!-- Franja Institucional de Pilares -->
      <div class="mt-12 pt-6 border-t border-gold-400/35 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 text-xs sm:text-sm">
        <div class="flex items-center gap-2.5 text-slate-200">
          <Icon name="columns" class="w-4 h-4 text-gold-300 shrink-0" />
          <span><strong>3 Poderes</strong> sin concentración</span>
        </div>
        <div class="flex items-center gap-2.5 text-slate-200">
          <Icon name="school" class="w-4 h-4 text-gold-300 shrink-0" />
          <span><strong>5 Niveles</strong> y Escuela de 6 meses</span>
        </div>
        <div class="flex items-center gap-2.5 text-slate-200">
          <Icon name="github" class="w-4 h-4 text-gold-300 shrink-0" />
          <span><strong>Cuentas y actas</strong> auditables en línea</span>
        </div>
        <div class="flex items-center gap-2.5 text-slate-200">
          <Icon name="lock" class="w-4 h-4 text-gold-300 shrink-0" />
          <span><strong>Privacidad real</strong> sin exponer tu DNI</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Métricas Reales de Transparencia -->
  <section class="max-w-7xl mx-auto px-4 py-12" aria-labelledby="metricas-heading">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6">
      <div>
        <h2 id="metricas-heading" class="text-2xl sm:text-3xl font-bold text-navy-900">
          Tablero Público en Vivo (Auditoría Abierta)
        </h2>
        <p class="mt-1 text-sm text-ink-muted">
          Cifras 100% reales calculadas directamente desde los archivos públicos verificables del repositorio ({avanceCiudadano.faseActual} · Corte:{' '}
          <time datetime={avanceCiudadano.ultimaActualizacion}>{avanceCiudadano.ultimaActualizacion}</time>).
        </p>
      </div>
      <a href={`${REPO_URL}/commits/main`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-bold text-navy-800 underline underline-offset-4 hover:text-navy-700 shrink-0 sm:whitespace-nowrap">
        <Icon name="github" class="w-4 h-4" />
        <span>Ver historial de commits en GitHub</span>
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-border bg-white p-5 shadow-sm border-t-4 border-t-gold-400">
        <div class="flex items-center justify-between">
          <p class="text-xs font-bold uppercase tracking-wider text-ink-muted">Saldo de Tesorería</p>
          <Icon name="ledger" class="w-4 h-4 text-gold-700" />
        </div>
        <p class="mt-2 text-3xl font-bold text-navy-900 tabular-nums">
          {formatearMoneda(resumenTesoreria.saldoNetoCentimos, tesoreria.simbolo)}
        </p>
        <p class="mt-1 text-xs text-ink-muted">{resumenTesoreria.cantidadMovimientos} movimientos registrados</p>
      </div>

      <div class="rounded-xl border border-border bg-white p-5 shadow-sm border-t-4 border-t-navy-800">
        <div class="flex items-center justify-between">
          <p class="text-xs font-bold uppercase tracking-wider text-ink-muted">Base y Militancia</p>
          <Icon name="columns" class="w-4 h-4 text-navy-800" />
        </div>
        <p class="mt-2 text-3xl font-bold text-navy-900 tabular-nums">{totalBaseYMilitancia}</p>
        <p class="mt-1 text-xs text-ink-muted">
          {organigrama.arranqueFundacional.grupoFundadorTotal} fundadores · {organigrama.arranqueFundacional.baseInicialSimpatizantes} simpatizantes · {avanceCiudadano.militantesDigitalesVerificados} carnets PU-N4 en Fase 2
        </p>
      </div>

      <div class="rounded-xl border border-border bg-white p-5 shadow-sm border-t-4 border-t-navy-800">
        <div class="flex items-center justify-between">
          <p class="text-xs font-bold uppercase tracking-wider text-ink-muted">Firmas ROP Verificadas</p>
          <Icon name="document" class="w-4 h-4 text-navy-800" />
        </div>
        <p class="mt-2 text-3xl font-bold text-navy-900 tabular-nums">
          {avanceCiudadano.firmasRopVerificadas.toLocaleString('es-PE')}
        </p>
        <p class="mt-1 text-xs text-ink-muted">
          Meta referencial: {avanceCiudadano.metaFirmasRopReferencial.toLocaleString('es-PE')} · Comités provinciales: {avanceCiudadano.comitesProvincialesConstituidos} · {avanceCiudadano.notaFirmasRop}
        </p>
      </div>

      <div class="rounded-xl border border-border bg-white p-5 shadow-sm border-t-4 border-t-gold-400">
        <div class="flex items-center justify-between">
          <p class="text-xs font-bold uppercase tracking-wider text-ink-muted">Documentos y Actas</p>
          <Icon name="book" class="w-4 h-4 text-gold-700" />
        </div>
        <p class="mt-2 text-3xl font-bold text-navy-900 tabular-nums">
          {documentos.length} docs · {actas.length} {actas.length === 1 ? 'acta' : 'actas'}
        </p>
        <p class="mt-1 text-xs text-ink-muted">Biblioteca doctrinal y acuerdos públicos</p>
      </div>
    </div>
  </section>

  <!-- Comparativa Institucional -->
  <section class="max-w-7xl mx-auto px-4 pb-12" aria-labelledby="diferencia-heading">
    <div class="rounded-2xl border border-border bg-white p-6 sm:p-8 shadow-sm">
      <h2 id="diferencia-heading" class="text-2xl font-bold text-navy-900">
        ¿Por qué esta estructura rompe con la política tradicional?
      </h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-rose-200 bg-rose-50/60 p-5">
          <p class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-rose-800">
            <Icon name="x" class="w-4 h-4" />
            <span>Partidos tradicionales</span>
          </p>
          <ul class="mt-3 space-y-2 text-sm text-ink">
            <li>Un solo dueño o cúpula define candidaturas a puerta cerrada.</li>
            <li>Finanzas opacas conocidas recién tras escándalos o campañas.</li>
            <li>Cualquiera compra un cupo electoral sin formación ni arraigo.</li>
          </ul>
        </div>

        <div class="rounded-xl border-2 border-gold-400 bg-navy-900 text-white p-5">
          <p class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gold-300">
            <Icon name="check" class="w-4 h-4" />
            <span>Modelo Partido Plus Ultra</span>
          </p>
          <ul class="mt-3 space-y-2 text-sm text-slate-200">
            <li>Quienes dirigen la moral y finanzas (N1/N2) tienen prohibido postular y tener empresas.</li>
            <li>Cuentas y actas públicas auditables por historial de cambios en repositorio abierto.</li>
            <li>Única cantera electoral (Nivel 3) tras 6 meses obligatorios de Escuela Política sin atajos.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Los Tres Poderes -->
  <section class="bg-surface-muted border-y border-border py-12" aria-labelledby="poderes-resumen-heading">
    <div class="max-w-7xl mx-auto px-4">
      <h2 id="poderes-resumen-heading" class="text-2xl sm:text-3xl font-bold text-navy-900">
        Separación de Poderes sin Concentración
      </h2>
      <p class="mt-2 text-sm sm:text-base text-ink-muted max-w-3xl">
        Ningún líder concentra el poder moral, las reglas ni las candidaturas. Quienes custodian la doctrina y los fondos tienen prohibido postular a cargos públicos.
      </p>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {organigrama.poderes.map((poder) => (
          <article class="rounded-xl bg-white border border-border p-6 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-gold-700">Poder 0{poder.orden}</span>
                <Icon
                  name={poder.id === 'ejecutivo' ? 'shield' : poder.id === 'constitucional' ? 'scale' : 'columns'}
                  class="w-5 h-5 text-navy-800"
                />
              </div>
              <h3 class="mt-2 text-xl font-bold text-navy-900">{poder.nombre}</h3>
              <p class="text-sm font-semibold text-navy-700">{poder.subtitulo}</p>
              <p class="mt-3 text-sm text-ink leading-relaxed">{poder.funcion}</p>
            </div>
            <div class="mt-5 pt-4 border-t border-border text-xs font-bold flex items-center gap-1.5">
              {poder.puedePostular ? (
                <span class="inline-flex items-center gap-1.5 text-emerald-800">
                  <Icon name="check" class="w-4 h-4" />
                  <span>Única cantera autorizada para elecciones</span>
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 text-rose-800">
                  <Icon name="lock" class="w-4 h-4" />
                  <span>Prohibido postular a cargos públicos y tener empresas</span>
                </span>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Información general en 4 ejes ciudadanos -->
  <section class="max-w-7xl mx-auto px-4 py-12" aria-labelledby="informacion-general-heading">
    <h2 id="informacion-general-heading" class="text-2xl sm:text-3xl font-bold text-navy-900">
      Información general y participación
    </h2>
    <p class="mt-1 text-sm text-ink-muted max-w-3xl">
      Explora nuestros principios, el proceso programático y las reglas reales de ascenso dentro del partido.
    </p>

    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <article class="rounded-xl border border-border p-6 bg-white shadow-sm flex flex-col justify-between">
        <div>
          <Icon name="book" class="w-6 h-6 text-gold-700" />
          <h3 class="mt-3 text-lg font-bold text-navy-900">1. Ideología y Doctrina</h3>
          <p class="mt-2 text-sm text-ink-muted">
            Conoce los valores fundacionales, el documento básico v2 y las reglas de contrapesos del partido.
          </p>
        </div>
        <a href={withBase('/biblioteca/')} class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-navy-900 underline underline-offset-4 hover:text-navy-700">
          <span>Ir a Doctrina y Biblioteca</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </article>

      <article class="rounded-xl border border-border p-6 bg-white shadow-sm flex flex-col justify-between">
        <div>
          <Icon name="scale" class="w-6 h-6 text-gold-700" />
          <h3 class="mt-3 text-lg font-bold text-navy-900">2. Plan de Gobierno y Propuestas</h3>
          <p class="mt-2 text-sm text-ink-muted">
            Revisa nuestros pilares vigentes, el método interno de los tres poderes y los ejes en debate fundacional.
          </p>
        </div>
        <a href={withBase('/propuestas/')} class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-navy-900 underline underline-offset-4 hover:text-navy-700">
          <span>Ver Plan de Gobierno</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </article>

      <article class="rounded-xl border border-border p-6 bg-white shadow-sm flex flex-col justify-between">
        <div>
          <Icon name="qr" class="w-6 h-6 text-gold-700" />
          <h3 class="mt-3 text-lg font-bold text-navy-900">3. Ascenso y Militancia (Nivel 4)</h3>
          <p class="mt-2 text-sm text-ink-muted">
            Conoce el pacto de militancia anónima con carnet digital y prueba el verificador criptográfico con QR real.
          </p>
        </div>
        <a href={withBase('/militancia/')} class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-navy-900 underline underline-offset-4 hover:text-navy-700">
          <span>Ver Plan de Militancia</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </article>

      <article class="rounded-xl border border-border p-6 bg-white shadow-sm flex flex-col justify-between">
        <div>
          <Icon name="school" class="w-6 h-6 text-gold-700" />
          <h3 class="mt-3 text-lg font-bold text-navy-900">4. Escuela Política (6 meses)</h3>
          <p class="mt-2 text-sm text-ink-muted">
            Quien aspire a dirigir o postular (Nivel 3) debe aprobar obligatoriamente 6 meses continuos sin atajos.
          </p>
        </div>
        <a href={withBase('/escuela-politica/')} class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-navy-900 underline underline-offset-4 hover:text-navy-700">
          <span>Conocer la Escuela Política</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </article>
    </div>

    <!-- Cierre Participa y Difunde -->
    <div class="mt-8 rounded-2xl bg-navy-900 text-white border-2 border-gold-400 p-6 sm:p-8 shadow-lg space-y-5">
      <div class="space-y-2 max-w-3xl">
        <h3 class="text-xl sm:text-2xl font-bold text-white">
          Participa y Difunde con Transparencia (Kit WhatsApp)
        </h3>
        <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
          La emisión en línea de carnets oficiales Nivel 4 iniciará en la <strong>Fase 2</strong> sin exponer identidades personales. Hoy ya puedes verificar nuestro modelo de carnet con QR, compartir este portal o descargar el PDF oficial para reenviarlo por WhatsApp sin gastar megas de navegación.
        </p>
        <p class="text-xs text-gold-300">
          Canal oficial unidireccional de simpatizantes (Nivel 5): en registro bajo custodia del Poder Constitucional (Nivel 2).
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href={withBase('/militancia/')}
          class="btn inline-flex items-center gap-2 rounded-lg bg-gold-400 text-navy-950 px-4 py-2.5 text-sm font-bold hover:bg-gold-300"
        >
          <Icon name="qr" class="w-4 h-4 shrink-0" />
          <span>Conocer Militancia Nivel 4 y Verificador</span>
        </a>
        <CompartirWhatsapp
          mensaje="Conoce el portal abierto del Partido Plus Ultra (Perú): transparencia en cuentas, 3 poderes, 5 niveles y Escuela Política obligatoria."
          variante="oscura"
        />
        <a
          href={withBase('/documentos/estructura-basica-v2.pdf')}
          class="btn inline-flex items-center gap-2 rounded-lg bg-navy-800 border border-gold-400 text-white px-4 py-2.5 text-sm font-bold hover:bg-navy-700"
        >
          <Icon name="download" class="w-4 h-4 text-gold-300 shrink-0" />
          <span>Descargar resumen PDF</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Preguntas Frecuentes en Portada -->
  <section class="max-w-7xl mx-auto px-4 pb-6">
    <AccordionFaq
      headingId="faq-inicio-heading"
      titulo="Preguntas Frecuentes"
      items={faqInicio}
    />
  </section>
</BaseLayout>
