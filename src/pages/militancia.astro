---
import BaseLayout from '../layouts/BaseLayout.astro';
import VerificadorCarnet from '../components/VerificadorCarnet.astro';
import AccordionFaq from '../components/AccordionFaq.astro';
import { withBase } from '../lib/url';

const faqItems = [
  {
    pregunta: '¿Por qué la inscripción de Nivel 4 es anónima en la plataforma web?',
    respuesta:
      'Para proteger al militante operativo frente a represalias laborales o políticas. El sistema emitirá un carnet digital pseudónimo (PU-N4) firmado criptográficamente con Ed25519 sin publicar nombres ni DNI en el repositorio público.',
  },
  {
    pregunta: '¿Estoy obligado a postular a un cargo o subir a Nivel 3?',
    respuesta:
      'No. Puedes permanecer indefinidamente en el Nivel 4 como miembro oficial con tu carnet digital colaborando en campañas, firmas y difusión. El salto a Nivel 3 es solo para quienes decidan cursar la Escuela Política y asumir responsabilidades dirigenciales o candidaturas.',
  },
  {
    pregunta: '¿Cuándo se activará la emisión en línea de carnets oficiales?',
    respuesta:
      'Actualmente estamos en Fase 1 (Portal de Transparencia estático en GitHub Pages). Para proteger la privacidad real de los inscritos, la emisión oficial se activará en Fase 2 sobre un backend gratuito aislado (Cloudflare Workers + D1 o Supabase Free), evitando emitir falsos carnets simulados en esta etapa.',
  },
  {
    pregunta: '¿Cómo se relaciona el carnet anónimo con el registro legal ante el JNE / ROP?',
    respuesta:
      'Están arquitectónicamente separados. El registro legal con DNI exigido por la legislación electoral peruana y la postulación desde Nivel 3 se custodian por separado bajo el Poder Constitucional (Nivel 2), nunca en GitHub.',
  },
];
---

<BaseLayout
  title="Militancia y Verificador"
  description="Reglas de la Militancia Operativa Nivel 4, transición al Nivel 3 y verificador criptográfico Ed25519 de carnets del Partido Plus Ultra."
>
  <div class="max-w-7xl mx-auto px-4 py-10 space-y-12">
    <header class="space-y-3 border-b border-border pb-6">
      <p class="text-xs font-bold uppercase tracking-widest text-gold-700">Participación Ciudadana</p>
      <h1 id="contenido-principal" tabindex="-1" class="text-3xl sm:text-4xl font-extrabold text-navy-900">
        Militancia Operativa (Nivel 4) y Verificador Oficial
      </h1>
      <p class="text-base text-ink-muted max-w-3xl">
        Regla oficial del partido: quien se registra por la web ingresa directamente como miembro de <strong>Nivel 4</strong> con su carnet digital; quien desee pasar a ser dirigente o candidato (<strong>Nivel 3</strong>) debe aprobar obligatoriamente la Escuela Política.
      </p>
    </header>

    <!-- Comparativa Nivel 4 vs Nivel 3 -->
    <section aria-labelledby="niveles-comparativa-heading" class="grid gap-6 md:grid-cols-2">
      <h2 id="niveles-comparativa-heading" class="visually-hidden">Comparativa entre Nivel 4 y Nivel 3</h2>
      <article class="rounded-2xl border border-border bg-surface-muted p-6">
        <span class="inline-block rounded bg-navy-900 text-gold-300 text-xs font-bold px-2.5 py-1 uppercase">Nivel 4 · Los Comprometidos</span>
        <h3 class="mt-3 text-xl font-extrabold text-navy-900">Militancia Operativa con Carnet Digital</h3>
        <ul class="mt-3 list-disc pl-5 space-y-2 text-sm text-ink">
          <li>Registro digital anónimo en Fase 2 con emisión de carnet <code>PU-N4</code>.</li>
          <li>Colaboración en campañas, recolección de firmas y trabajo territorial.</li>
          <li>Permanencia voluntaria indefinida: sin obligación de postular a cargos públicos.</li>
        </ul>
      </article>

      <article class="rounded-2xl border-2 border-gold-400 bg-navy-900 text-white p-6">
        <span class="inline-block rounded bg-gold-400 text-navy-950 text-xs font-bold px-2.5 py-1 uppercase">Nivel 3 · La Asamblea / Cantera</span>
        <h3 class="mt-3 text-xl font-extrabold text-white">Cuerpo Pleno del Partido y Candidatos</h3>
        <ul class="mt-3 list-disc pl-5 space-y-2 text-sm text-slate-200">
          <li>Requiere aprobar obligatoriamente la Escuela Política (mínimo 6 meses, sin atajos).</li>
          <li>Certificación emitida por docentes de Nivel 1 y Nivel 2.</li>
          <li>Única cantera autorizada para postular a Presidencia, Congreso, Alcaldías y Ministerios.</li>
        </ul>
        <a href={withBase('/escuela-politica/')} class="mt-4 inline-block text-sm font-bold text-gold-300 underline underline-offset-4">
          Ver requisitos de la Escuela Política →
        </a>
      </article>
    </section>

    <!-- Aviso honesto Fase 1 vs Fase 2 -->
    <section class="rounded-xl border border-amber-600 bg-amber-50 text-amber-950 p-5" aria-labelledby="estado-registro-heading">
      <h2 id="estado-registro-heading" class="text-base font-extrabold">
        Estado Transparente de Inscripción Digital (Fase 1)
      </h2>
      <p class="mt-1 text-sm leading-relaxed">
        Este portal opera actualmente de forma 100% estática en GitHub Pages para garantizar costo cero y auditoría pública. Para evitar falsos carnets locales sin validez real, el formulario de registro anónimo se habilitará en la <strong>Fase 2</strong> (servidor gratuito aislado). Mientras tanto, ya puedes auditar y probar abajo el <strong>Verificador Oficial Ed25519</strong>.
      </p>
    </section>

    <VerificadorCarnet />

    <AccordionFaq
      headingId="faq-militancia-heading"
      titulo="Preguntas Frecuentes sobre Anonimato y Carnets"
      items={faqItems}
    />
  </div>
</BaseLayout>
