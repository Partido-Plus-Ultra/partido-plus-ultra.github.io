---
import BaseLayout from '../layouts/BaseLayout.astro';
import PiramideInteractiva from '../components/PiramideInteractiva.astro';
import Icon from '../components/Icon.astro';
import organigrama from '../data/organigrama.json';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="Estructura y Poderes"
  description="Detalle completo de los tres poderes internos, cinco niveles escalonados, rotaciones y prohibiciones del Partido Plus Ultra."
>
  <div class="max-w-7xl mx-auto px-4 py-10 space-y-12">
    <header class="rounded-2xl bg-civic-grid text-white p-6 sm:p-10 border-2 border-gold-400 shadow-lg space-y-4">
      <p class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-gold-300">
        <Icon name="columns" class="w-4 h-4" />
        <span>Arquitectura Orgánica</span>
      </p>
      <h1 id="contenido-principal" tabindex="-1" class="font-bold text-white">
        Estructura Orgánica: Tres Poderes y Cinco Niveles
      </h1>
      <p class="text-base text-slate-200 max-w-3xl leading-relaxed">
        {organigrama.partido.identidad.resumen}
      </p>
      <div class="pt-2">
        <a
          href={withBase('/documentos/estructura-basica-v2.pdf')}
          class="btn inline-flex items-center gap-2 rounded-lg bg-gold-400 text-navy-950 px-5 py-2.5 text-sm font-bold hover:bg-gold-300"
        >
          <Icon name="download" class="w-4 h-4" />
          <span>Descargar Documento Oficial PDF (v2)</span>
        </a>
      </div>
    </header>

    <PiramideInteractiva />

    <!-- Reglas de Arranque Fundacional -->
    <section aria-labelledby="arranque-heading" class="space-y-6">
      <div>
        <h2 id="arranque-heading" class="text-2xl sm:text-3xl font-bold text-navy-900">
          Plan de Arranque Fundacional ({organigrama.arranqueFundacional.grupoFundadorTotal} fundadores + {organigrama.arranqueFundacional.baseInicialSimpatizantes} simpatizantes)
        </h2>
        <p class="mt-1 text-sm text-ink-muted">
          Distribución inicial de responsabilidades definida en el documento fundacional.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {organigrama.arranqueFundacional.distribucion.map((item) => (
          <article class="rounded-xl border border-border bg-white p-5 shadow-sm border-t-4 border-t-gold-400">
            <p class="text-xs font-bold uppercase tracking-wider text-gold-700">Nivel {item.nivel}</p>
            <p class="mt-1 text-2xl font-bold text-navy-900 tabular-nums">{item.cantidad} personas</p>
            <p class="mt-2 text-sm text-ink leading-snug">{item.rol}</p>
          </article>
        ))}
      </div>

      <div class="rounded-xl border-s-4 border-gold-400 bg-navy-900 text-slate-100 p-5 text-sm shadow-sm">
        <p class="font-bold text-gold-300 flex items-center gap-2">
          <Icon name="scale" class="w-4 h-4" />
          <span>Claridad Normativa sobre Docencia y Logística</span>
        </p>
        <p class="mt-1.5 leading-relaxed">{organigrama.arranqueFundacional.notaDesambiguacion}</p>
      </div>
    </section>

    <!-- Infografía oficial -->
    <section aria-labelledby="infografia-heading" class="space-y-4">
      <h2 id="infografia-heading" class="text-2xl font-bold text-navy-900">
        Infografía Visual Oficial de Referencia
      </h2>
      <figure class="rounded-2xl overflow-hidden border-2 border-navy-900 bg-navy-950 max-w-4xl shadow-md">
        <img
          src={withBase('/img/infografia-estructura-partido.jpg')}
          alt="Diagrama visual de los tres poderes (Ejecutivo, Constitucional, Legislativo) y los cinco niveles del Partido Plus Ultra."
          class="w-full h-auto block"
          width="1200"
          height="675"
          loading="lazy"
        />
        <figcaption class="px-5 py-3.5 text-xs sm:text-sm text-slate-200 bg-navy-950 border-t border-navy-800">
          Esquema oficial del Partido Plus Ultra: Nivel 1 (Triunvirato) y Nivel 2 (Poder Constitucional) no postulan ni poseen empresas; Nivel 3 (Asamblea Dirigencial) concentra la cantera electoral tras aprobar 6 meses obligatorios de Escuela Política.
        </figcaption>
      </figure>
    </section>
  </div>
</BaseLayout>
